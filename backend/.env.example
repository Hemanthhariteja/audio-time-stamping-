# Backend Environment Template
# Copy this to .env.local in the backend directory for local development

# ========================================
# APPLICATION CONFIGURATION
# ========================================

APP_NAME=Audio Timestamping Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ========================================
# DATABASE CONFIGURATION
# ========================================

# SQLite for development
DATABASE_URL=sqlite:///./app.db

# PostgreSQL for production (commented out)
# DATABASE_URL=postgresql://user:password@localhost:5432/audio_timestamping

# ========================================
# SERVER CONFIGURATION
# ========================================

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ========================================
# CORS CONFIGURATION
# ========================================

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ========================================
# FILE STORAGE CONFIGURATION
# ========================================

UPLOAD_DIR=./uploads
UPLOAD_RAW_DIR=./uploads/raw
UPLOAD_PROCESSED_DIR=./uploads/processed
UPLOAD_EXPORTS_DIR=./uploads/exports

MAX_UPLOAD_SIZE_MB=200
MAX_AUDIO_DURATION_MINUTES=10

ALLOWED_AUDIO_FORMATS=mp3,wav,m4a,aac,ogg,flac,mp4

# ========================================
# AUDIO PROCESSING (FFmpeg)
# ========================================

FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_SECONDS=600
FFMPEG_SAMPLE_RATE=16000
FFMPEG_CHANNELS=1

# ========================================
# WHISPER MODEL CONFIGURATION
# ========================================

WHISPER_MODEL_NAME=medium
WHISPER_MODEL_CACHE=./models
WHISPER_LANGUAGE=en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Inference Parameters
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_TEMPERATURE=0
WHISPER_WORD_TIMESTAMPS=true
WHISPER_VAD_FILTER=true
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true

# ========================================
# RATE LIMITING
# ========================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD_SECONDS=3600

# Per-endpoint limits
UPLOAD_RATE_LIMIT=10/hour
TRANSCRIBE_RATE_LIMIT=20/hour
SEARCH_RATE_LIMIT=100/hour
EXPORT_RATE_LIMIT=50/hour

# ========================================
# AUTHENTICATION (for future use)
# ========================================

SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# ========================================
# LOGGING CONFIGURATION
# ========================================

LOG_FORMAT=json
LOG_FILE=./logs/app.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5

# ========================================
# SECURITY
# ========================================

# Security Headers
ENABLE_SECURITY_HEADERS=true
ALLOWED_HOSTS=localhost,127.0.0.1

# File upload security
SECURE_FILENAME_GENERATION=true
SCAN_UPLOADED_FILES=false

# ========================================
# PERFORMANCE
# ========================================

# Database connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Cache settings
ENABLE_CACHE=true
CACHE_TTL_SECONDS=300

# ========================================
# MONITORING & OBSERVABILITY
# ========================================

ENABLE_METRICS=true
ENABLE_TRACING=false
SENTRY_DSN=

# ========================================
# HARDWARE DETECTION
# ========================================

AUTO_DETECT_CUDA=true
AUTO_DETECT_MEMORY=true
FALLBACK_TO_CPU=true
MIN_GPU_MEMORY_MB=4000

