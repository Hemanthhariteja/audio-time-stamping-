# Frontend Environment Template
# Copy this to .env.local in the frontend directory for local development

# ========================================
# API CONFIGURATION
# ========================================

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# ========================================
# APPLICATION CONFIGURATION
# ========================================

NEXT_PUBLIC_APP_NAME=Audio Timestamping
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_ENVIRONMENT=development

# ========================================
# FEATURE FLAGS
# ========================================

NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_EXPORT=true
NEXT_PUBLIC_ENABLE_SEARCH=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_SENTRY=false

# ========================================
# AUDIO SETTINGS
# ========================================

NEXT_PUBLIC_MAX_AUDIO_DURATION_MINUTES=10
NEXT_PUBLIC_MAX_FILE_SIZE_MB=200
NEXT_PUBLIC_SUPPORTED_FORMATS=mp3,wav,m4a,aac,ogg,flac,mp4

# ========================================
# UI CONFIGURATION
# ========================================

# Pagination
NEXT_PUBLIC_ITEMS_PER_PAGE=10
NEXT_PUBLIC_MAX_ITEMS_PER_PAGE=100

# Toast Notifications
NEXT_PUBLIC_TOAST_DURATION_MS=3000
NEXT_PUBLIC_TOAST_POSITION=bottom-right

# Upload
NEXT_PUBLIC_UPLOAD_CHUNK_SIZE=1048576

# ========================================
# PLAYBACK SETTINGS
# ========================================

NEXT_PUBLIC_DEFAULT_PLAYBACK_SPEED=1
NEXT_PUBLIC_PLAYBACK_SPEEDS=0.5,0.75,1,1.25,1.5,2
NEXT_PUBLIC_DEFAULT_VOLUME=0.8

# ========================================
# POLLING CONFIGURATION
# ========================================

NEXT_PUBLIC_POLLING_INTERVAL_MS=1000
NEXT_PUBLIC_POLLING_MAX_RETRIES=60

# ========================================
# DEBUG & DEVELOPMENT
# ========================================

NEXT_PUBLIC_DEBUG=true
NEXT_PUBLIC_LOG_LEVEL=info

# ========================================
# ANALYTICS (optional)
# ========================================

NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=

# ========================================
# STYLING
# ========================================

NEXT_PUBLIC_THEME_COLOR=#000000
NEXT_PUBLIC_PRIMARY_COLOR=#3b82f6
NEXT_PUBLIC_SECONDARY_COLOR=#8b5cf6

# ========================================
# API ENDPOINTS (for reference)
# ========================================

# These are derived from API_BASE_URL but listed for clarity
# POST {API_BASE_URL}/upload
# GET {API_BASE_URL}/projects
# GET {API_BASE_URL}/project/{id}
# GET {API_BASE_URL}/transcript/{id}
# GET {API_BASE_URL}/search
# POST {API_BASE_URL}/export
# DELETE {API_BASE_URL}/project/{id}

